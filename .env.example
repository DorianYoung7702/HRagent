# Database
# Optional PostgreSQL deployment:
# DATABASE_URL=postgresql+asyncpg://recruiting:recruiting@localhost:5432/recruiting
# Default single-node deployment (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./data/recruiting.db

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=recruiting-task-queue

# DeepSeek (OpenAI-compatible API)
# 申请地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Set a model available to your own provider account.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=120
# 系统代理导致 ConnectError 时设为 false（默认，Windows 常见）
DEEPSEEK_TRUST_ENV=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Playwright
BROWSER_PROFILE_DIR=./data/browser_profiles/hr_default
BROWSER_HEADLESS=true

# Outreach
SEND_MODE=draft_first

# API
API_HOST=127.0.0.1
API_PORT=8001
API_BASE_URL=http://localhost:8001

# Reply ingestion
REPLY_SCAN_INTERVAL_MINUTES=5

# 全局 Agent 招聘方身份（IM 话术）
HR_COMPANY_NAME=
HRAGENT_TALENT_ARCHIVE_ENABLED=0

# Application version and local runtime paths
APP_VERSION=0.1.0
# Optional process environment overrides (otherwise ./data is used):
# HRAGENT_DATA_DIR=./data
# HRAGENT_CONFIG_PATH=./data/config/runtime.json
